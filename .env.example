# This tracked example is documentation only; the application does not read .env files.
# Never place real credentials in this tracked example.

CCS_ENV=DEV
CCS_API_HOST=127.0.0.1
CCS_API_PORT=8000
CCS_UI_API_URL=http://127.0.0.1:8000

# Secret values are intentionally absent. Future adapters must use secret-store
