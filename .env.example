# Copy to .env only when application configuration is implemented.
# Never place real credentials in this tracked example.

CCS_PROFILE=DEV
CCS_HOST=127.0.0.1
CCS_API_PORT=8000
CCS_UI_PORT=8501

# Secret values are intentionally absent. Future adapters must use secret-store
# locators (for example, vault/provider identifiers), not raw API keys here.
